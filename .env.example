# ── Obavezno ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:TVOJA_POSTGRES_LOZINKA@localhost:5432/art_studio"

# JWT tajni ključ — OBAVEZNO nasumičan. Generiši sa:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="ZAMIJENI_NASUMICNIM_KLJUCEM"

# ── Admin kredencijali (koriste se samo jednom pri prvom setup-u) ─────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ZAMIJENI_JAKOM_LOZINKOM"

# ── Opciono ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# URL sajta — koristi se za CORS u produkciji (bez trailing slash-a)
# SITE_URL=https://387cinematicweddings.com

# ── Setup (samo jednom!) ──────────────────────────────────────────────────────
# Postavi na "true" samo kad pokrećeš /api/auth/setup da kreiraš prvog admina.
# Nakon kreiranja admina ODMAH ukloni ovu liniju ili postavi na "false".
# ALLOW_SETUP=true
